# Copy to ".env" and paste your token (never commit .env).
# Create a token: https://huggingface.co/settings/tokens
#
# huggingface_hub reads HF_TOKEN (preferred) or HUGGING_FACE_HUB_TOKEN.
# HUGGINGFACE_HUB_TOKEN (no underscore) is a common mistake — use HF_TOKEN instead.
HF_TOKEN=

# Optional: only for scripts/llm_baseline.py (Claude LLM-only comparator).
# Get a key at https://console.anthropic.com/ ; never commit the real .env.
ANTHROPIC_API_KEY=
# Required only if the key is identity-linked (error: 'anthropic-workspace-id is required').
# Console -> Settings -> Workspaces; looks like wrkspc_01...
ANTHROPIC_WORKSPACE_ID=

# Optional: Groq (fast open-weight LLMs) for the study reply generator and
# scripts/llm_baseline.py --provider groq. https://console.groq.com/keys
GROQ_API_KEY=

# Remote study (docker compose): reply provider must be groq; domain for Caddy's HTTPS certificate.
LLM_PROVIDER=groq
STUDY_DOMAIN=study.example.edu
